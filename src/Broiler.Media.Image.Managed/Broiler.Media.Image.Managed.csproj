<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Broiler.Media.Image.Managed</RootNamespace>
    <AssemblyName>Broiler.Media.Image.Managed</AssemblyName>
    <Description>Managed, cross-platform image codec implementation for Broiler.Media.Image.</Description>
    <PackageTags>broiler;media;image;managed</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Media.Image\Broiler.Media.Image.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Broiler.Media.Image.Managed.Tests" />
    <!-- Sets ImageDecodeParallelism.MaxDegreeOfParallelism to measure decode scaling (items #6, #7). -->
    <InternalsVisibleTo Include="Broiler.Render.Stage.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(BroilerNativeRoot)/src/Broiler.Native.Windows/Broiler.Native.Windows.csproj" Condition="Exists('$(BroilerNativeRoot)/src/Broiler.Native.Windows/Broiler.Native.Windows.csproj')" />
    <PackageReference Include="Broiler.Native.Windows" Version="$(BroilerNativeVersion)" Condition="!Exists('$(BroilerNativeRoot)/src/Broiler.Native.Windows/Broiler.Native.Windows.csproj')" />
  </ItemGroup>
</Project>
