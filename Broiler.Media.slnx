<Solution>
  <Folder Name="/src/">
    <Project Path="src/Broiler.Media/Broiler.Media.csproj" />
    <Project Path="src/Broiler.Media.Audio/Broiler.Media.Audio.csproj" />
    <Project Path="src/Broiler.Media.Audio.Managed/Broiler.Media.Audio.Managed.csproj" />
    <Project Path="src/Broiler.Media.Video/Broiler.Media.Video.csproj" />
    <!-- These net10.0 libraries build and pack on every host; playback requires Windows. -->
    <Project Path="src/Broiler.Media.Video.Windows/Broiler.Media.Video.Windows.csproj" />
    <Project Path="src/Broiler.Media.Video.MediaFoundation/Broiler.Media.Video.MediaFoundation.csproj" />
    <Project Path="src/Broiler.Media.Image/Broiler.Media.Image.csproj" />
    <Project Path="src/Broiler.Media.Image.Managed/Broiler.Media.Image.Managed.csproj" />
    <!-- Dependencies-only meta-package over all runtime libraries. -->
    <Project Path="src/Broiler.Media.All/Broiler.Media.All.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="src/tests/Broiler.Media.Tests/Broiler.Media.Tests.csproj" />
    <Project Path="src/tests/Broiler.Media.Audio.Tests/Broiler.Media.Audio.Tests.csproj" />
    <Project Path="src/tests/Broiler.Media.Audio.Managed.Tests/Broiler.Media.Audio.Managed.Tests.csproj" />
    <Project Path="src/tests/Broiler.Media.Video.Tests/Broiler.Media.Video.Tests.csproj" />
    <!-- Builds on every host; the test script runs this suite only on Windows. -->
    <Project Path="src/tests/Broiler.Media.Video.MediaFoundation.Tests/Broiler.Media.Video.MediaFoundation.Tests.csproj" />
    <Project Path="src/tests/Broiler.Media.Image.Tests/Broiler.Media.Image.Tests.csproj" />
    <Project Path="src/tests/Broiler.Media.Image.Managed.Tests/Broiler.Media.Image.Managed.Tests.csproj" />
  </Folder>
</Solution>
